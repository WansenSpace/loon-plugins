#!name = TikTok 去挂件V2
#!desc = 屏蔽 TikTok 左上角积分/金币激励悬浮挂件（日区 P 币/福袋/TouchPoint/LuckyCat）：阻断字节海外 TTNet 纯 IP HTTPDNS 绕过与 QUIC，精准拦截 v47 专属激励图标图床（ug-incentive）、TTNet 重写后的 ugattribution/libra/widget/campaign/inapp 子域，不对核心视频流开启全局 MitM
#!openUrl = https://apps.apple.com/app/id835599320
#!author = WansenSpace
#!tag = 去广告
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TikTok.png
#!system = iOS
#!system_version = 15.0
#!loon_version = 3.2.1
#!date = 2026-11-28

[Rule]
# === 1. 阻断 QUIC 与字节海外 TTNet 纯 IP HTTPDNS（防止域名被拒后走 34.102.215.99 直连 IP 绕过规则） ===
PROTOCOL, QUIC, REJECT
IP-CIDR, 34.102.215.99/32, REJECT, no-resolve
IP-CIDR, 35.213.190.132/32, REJECT, no-resolve
IP-CIDR, 130.35.75.83/32, REJECT, no-resolve
DOMAIN, ttnet.tiktokv.com, REJECT
DOMAIN, dig.tiktokv.us, REJECT
DOMAIN, dig.us.tiktokv.com, REJECT
DOMAIN, dig.byteoversea.com, REJECT
DOMAIN, httpdns.byteoversea.com, REJECT
DOMAIN, doh.byteoversea.com, REJECT
DOMAIN, qdns-v5-tt.polaris.byteoversea.com, REJECT

# === 2. 阻断 TikTok 悬浮积分/金币挂件专属图标 CDN（v47 反编译实锤 ug-incentive 图床） ===
DOMAIN, p16-ug-incentive-img-sg.tiktokcdn.com, REJECT
DOMAIN, p16-ug-incentive-img-va.tiktokcdn.com, REJECT
DOMAIN, p19-ug-incentive-img-sg.tiktokcdn.com, REJECT
DOMAIN, p19-ug-incentive-img-va.tiktokcdn.com, REJECT
DOMAIN-KEYWORD, ug-incentive, REJECT
DOMAIN-KEYWORD, ugcdn-tos, REJECT

# === 3. 阻断 TTNet 内部重写后的 UG 归因、挂件（Widget/Campaign）与 Libra 活动实验开关 ===
# 注：TTNet 内置调度会将 ug-sg.byteoversea.com 重写为 ugattribution-sg -> ugattribution-boot.tiktokv.com
DOMAIN-KEYWORD, ugattribution, REJECT
DOMAIN-KEYWORD, ug-normal, REJECT
DOMAIN-KEYWORD, luckycat, REJECT
DOMAIN-KEYWORD, activity-spring-api, REJECT
DOMAIN-SUFFIX, incentive-bonus.com, REJECT
DOMAIN-SUFFIX, incentive-giveaway.com, REJECT
DOMAIN-SUFFIX, incentive-promo.com, REJECT
DOMAIN, campaign.tiktokv.com, REJECT
DOMAIN, campaign-va.tiktokv.com, REJECT
DOMAIN, campaign-sg.tiktokv.com, REJECT
DOMAIN, campaign-boot.tiktokv.com, REJECT
DOMAIN, widget.tiktokv.com, REJECT
DOMAIN, widget-va.tiktokv.com, REJECT
DOMAIN, widget-sg.tiktokv.com, REJECT
DOMAIN, widget-boot.tiktokv.com, REJECT
DOMAIN, libra-boot.tiktokv.com, REJECT
DOMAIN, libra-sg.tiktokv.com, REJECT
DOMAIN, libra-va.tiktokv.com, REJECT
DOMAIN, libra16-platform-useast5.us.tiktokv.com, REJECT
DOMAIN, libra32-normal-no1a.tiktokv.eu, REJECT
DOMAIN, abtest-sg.byteoversea.com, REJECT
DOMAIN, abtest-va.byteoversea.com, REJECT
DOMAIN, abtest-sg-tiktok.byteoversea.com, REJECT
DOMAIN, abtest-va-tiktok.byteoversea.com, REJECT
DOMAIN, abtest-va-tiktok-useast2a.byteoversea.com, REJECT

# === 4. TikTok 激励体系 / 内嵌活动容器（InApp / Activity / Incentive / UG）全区域集群 ===
DOMAIN-SUFFIX, inapp.tiktokv.com, REJECT
DOMAIN-SUFFIX, inapp.tiktokv.eu, REJECT
DOMAIN-SUFFIX, inapp.tiktokv.us, REJECT
DOMAIN-SUFFIX, activity.tiktok.com, REJECT
DOMAIN-SUFFIX, activity.tiktokv.com, REJECT
DOMAIN-SUFFIX, activity.musical.ly, REJECT
DOMAIN-SUFFIX, incentive.tiktok.com, REJECT
DOMAIN-SUFFIX, incentive.tiktokv.com, REJECT
DOMAIN-SUFFIX, ug.tiktokv.com, REJECT
DOMAIN, activity-va.tiktok.com, REJECT
DOMAIN, activity-sg.tiktok.com, REJECT
DOMAIN, ug-overseas.snssdk.com, REJECT
DOMAIN, ug-sg.byteoversea.com, REJECT
DOMAIN, ug-va.byteoversea.com, REJECT
DOMAIN, ug-alisg.byteoversea.com, REJECT
DOMAIN, ug-maliva.byteoversea.com, REJECT
DOMAIN, ug-va.tiktokv.com, REJECT
DOMAIN, ug-sg.tiktokv.com, REJECT
DOMAIN, ug-alisg.tiktokv.com, REJECT
DOMAIN, ug-i18n.tiktokv.com, REJECT
DOMAIN, ug16-normal-alisg.tiktokv.com, REJECT
DOMAIN, ug16-normal-c-alisg.tiktokv.com, REJECT
DOMAIN, ug19-normal-c-alisg.tiktokv.com, REJECT
DOMAIN, ug21-normal-c-alisg.tiktokv.com, REJECT
DOMAIN, ug22-normal-c-alisg.tiktokv.com, REJECT
DOMAIN, ug31-normal-alisg.tiktokv.com, REJECT
DOMAIN, ug32-normal-alisg.tiktokv.com, REJECT
DOMAIN, ug16-normal-c-useast1a.tiktokv.com, REJECT
DOMAIN, ug16-normal-c-useast2a.tiktokv.com, REJECT
DOMAIN, ug22-normal-c-useast1a.tiktokv.com, REJECT
DOMAIN, ug22-normal-c-useast2a.tiktokv.com, REJECT
DOMAIN, ug16-normal-no1a.tiktokv.eu, REJECT
DOMAIN, ug16-normal-useast5.us.tiktokv.com, REJECT
DOMAIN, activity-sg.tiktokv.com, REJECT
DOMAIN, activity-va.tiktokv.com, REJECT
DOMAIN, activity-alisg.tiktokv.com, REJECT
DOMAIN, activity-i18n.tiktokv.com, REJECT
DOMAIN, activity16-normal-alisg.tiktokv.com, REJECT
DOMAIN, activity16-normal-c-alisg.tiktokv.com, REJECT
DOMAIN, activity22-normal-c-alisg.tiktokv.com, REJECT
DOMAIN, activity16-normal-c-useast1a.tiktokv.com, REJECT
DOMAIN, activity16-normal-c-useast2a.tiktokv.com, REJECT
DOMAIN, inapp-sg.tiktokv.com, REJECT
DOMAIN, inapp-va.tiktokv.com, REJECT
DOMAIN, inapp-alisg.tiktokv.com, REJECT
DOMAIN, inapp16-normal-alisg.tiktokv.com, REJECT
DOMAIN, inapp16-normal-c-alisg.tiktokv.com, REJECT
DOMAIN, inapp22-normal-c-alisg.tiktokv.com, REJECT

# === 5. URL-REGEX 泛匹配兜底（拦截动态分片域名，不含逗号） ===
URL-REGEX, ^https?:\/\/(ug|ugattribution|inapp|incentive|luckycat|campaign|widget|libra)[0-9a-z-]*\.(tiktokv\.(com|eu|us)|tiktok\.com|byteoversea\.(com|net)|tik-tokapi\.com|musical\.ly), REJECT
URL-REGEX, ^https?:\/\/activity[0-9a-z-]*\.(tiktokv\.(com|eu|us)|tiktok\.com|byteoversea\.(com|net)|musical\.ly), REJECT
URL-REGEX, ^https?:\/\/[0-9a-z-]*ug-incentive[0-9a-z-]*\.(tiktokcdn(-us|-eu)?\.com|ibyteimg\.com|ibytedtos\.com), REJECT

[Rewrite]
# === 1. 阻断 TTNet 明文/HTTPS 纯 IP HTTPDNS 查询 ===
^https?:\/\/(34\.102\.215\.99|35\.213\.190\.132|130\.35\.75\.83)\/.* reject

# === 2. 内嵌激励 H5 / Falcon 容器与实验配置静默返回空字典 ===
^https?:\/\/(inapp|activity|incentive|ug|ugattribution|campaign|widget|libra)[0-9a-z-]*\.(tiktokv\.(com|eu|us)|tiktok\.com|byteoversea\.com)\/.* reject-dict

# === 3. TouchPoint / LuckyCat / UG 悬浮挂件与激励任务接口净化 ===
^https?:\/\/[^\/]+\.(tiktokv\.(com|eu|us)|byteoversea\.com|tik-tokapi\.com|tiktok\.com|musical\.ly)\/(?:tiktok\/(?:touchpoint|incentive|ug|referral|bonus)|luckycat|falcon\/(?:incentive|luckycat|ug)|aweme\/v[0-9]+\/(?:ug|touchpoint|incentive|spec_act|pendant|referral))(?:\/|\?|$) reject-dict

# === 4. 悬浮金币/积分挂件动图与静态资源包拦截 ===
^https?:\/\/[^\/]+\.(ibytedtos\.com|tiktokcdn(-us|-eu)?\.com|ibyteimg\.com|ipstatp\.com)\/.*(?:ug[-_]incentive|tiktok[-_]incentive|luckycat|touchpoint|coin[-_]pendant|reward[-_]pendant|incentive[-_]campaign) reject-200

[MitM]
# 仅针对独立的激励/活动/内嵌容器与挂件图床开启 MitM（绝不加入 *.tiktokv.com，防止 App Store 版触发 SSL Pinning 无法加载视频）
hostname = inapp.tiktokv.com, inapp-sg.tiktokv.com, inapp-va.tiktokv.com, inapp-alisg.tiktokv.com, activity.tiktok.com, activity-va.tiktok.com, activity-sg.tiktok.com, activity.tiktokv.com, activity-sg.tiktokv.com, activity-va.tiktokv.com, activity-alisg.tiktokv.com, incentive.tiktok.com, incentive.tiktokv.com, ug.tiktokv.com, ug-va.tiktokv.com, ug-sg.tiktokv.com, ug-alisg.tiktokv.com, ug-sg.byteoversea.com, ug-va.byteoversea.com, ugattribution-sg.tiktokv.com, ugattribution-boot.tiktokv.com, campaign-va.tiktokv.com, campaign-sg.tiktokv.com, widget-va.tiktokv.com, widget-sg.tiktokv.com, p16-ug-incentive-img-sg.tiktokcdn.com, p16-ug-incentive-img-va.tiktokcdn.com
