#!name = 中国电信去开屏广告V2
#!desc = 拦截中国电信 App 自研多活开屏广告网关（appgoadhd / appgoadsz / appgoad）、欢迎页动画、电信 21CN 广告联盟子域及国内主流三方聚合广告 SDK，屏蔽 QUIC 防止绕过；不拦截 appgohd / appgosz / appgologinsz 等核心业务与登录域
#!openUrl = https://apps.apple.com/cn/app/id513836029
#!author = WansenSpace
#!tag = 去广告
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ChinaTetlcom.png
#!system = iOS
#!system_version = 15.0
#!loon_version = 3.2.1
#!date = 2026-11-28

[Rule]
# === 1. 屏蔽 QUIC，防止绕过域名规则与 MitM ===
PROTOCOL, QUIC, REJECT

# === 2. 中国电信 AppGo 自研多活开屏广告网关（抓包实测：appgoadhd.189.cn 等） ===
# 说明：核心业务走 appgohd.189.cn / appgosz.189.cn，登录走 appgologinsz.189.cn，均不受影响；Rule 层直接拒绝，无视 SSL Pinning
DOMAIN, appgoad.189.cn, REJECT
DOMAIN, appgoadhd.189.cn, REJECT
DOMAIN, appgoadsz.189.cn, REJECT
DOMAIN-KEYWORD, appgoad, REJECT

# === 3. 中国电信 / 21CN 广告与统计子域（不拦截 e.189.cn / client.189.cn 等核心业务域） ===
DOMAIN, ad.21cn.com, REJECT
DOMAIN, ad.k.21cn.com, REJECT
DOMAIN, admarket.21cn.com, REJECT
DOMAIN, adshows.21cn.com, REJECT
DOMAIN, market.21cn.com, REJECT
DOMAIN, analytics.21cn.com, REJECT
DOMAIN, analytics.tv189.cn, REJECT
IP-CIDR, 122.229.8.47/32, REJECT, no-resolve
IP-CIDR, 122.229.29.89/32, REJECT, no-resolve

# === 3. 穿山甲 / 字节广告联盟 ===
DOMAIN-KEYWORD, pangolin-sdk-toutiao, REJECT
DOMAIN-SUFFIX, pglstatp-toutiao.com, REJECT
DOMAIN-SUFFIX, pangolin.snssdk.com, REJECT
DOMAIN-SUFFIX, csjplatform.com, REJECT

# === 4. 腾讯广点通 / 优量汇 ===
DOMAIN-SUFFIX, gdt.qq.com, REJECT
DOMAIN-SUFFIX, gdtimg.com, REJECT
DOMAIN-SUFFIX, ugdtimg.com, REJECT
DOMAIN, pgdt.gtimg.cn, REJECT
DOMAIN, tangram.e.qq.com, REJECT
DOMAIN, sdk.e.qq.com, REJECT
DOMAIN, us.l.qq.com, REJECT
DOMAIN, l.qq.com, REJECT

# === 5. 百度移动广告联盟 / 百青藤 ===
DOMAIN-SUFFIX, mobads.baidu.com, REJECT
DOMAIN-SUFFIX, mobads-logs.baidu.com, REJECT
DOMAIN-SUFFIX, mobads-pre-config.cdn.bcebos.com, REJECT
DOMAIN-SUFFIX, cpro.baidu.com, REJECT
DOMAIN-SUFFIX, pos.baidu.com, REJECT
DOMAIN-SUFFIX, union.baidu.com, REJECT
DOMAIN-SUFFIX, als.baidu.com, REJECT

# === 6. 快手广告联盟 ===
DOMAIN-SUFFIX, e.kuaishou.com, REJECT
DOMAIN-SUFFIX, ad.v6.kuaishou.com, REJECT
DOMAIN-SUFFIX, promotion-partner.kuaishou.com, REJECT
DOMAIN-SUFFIX, gdfp.gifshow.com, REJECT

# === 7. Sigmob / TopOn / 倍孜 / 京东 / 阿里聚合广告 SDK ===
DOMAIN-SUFFIX, sigmob.cn, REJECT
DOMAIN-SUFFIX, sigmob.com, REJECT
DOMAIN-SUFFIX, anythinktech.com, REJECT
DOMAIN-SUFFIX, toponad.com, REJECT
DOMAIN-SUFFIX, beizi.biz, REJECT
DOMAIN, janapi.jd.com, REJECT
DOMAIN, dsp-x.jd.com, REJECT
DOMAIN-SUFFIX, tanx.com, REJECT
DOMAIN, adashx.m.taobao.com, REJECT

[Rewrite]
# === 1. 中国电信 App 开屏与欢迎页动画 ===
^https?:\/\/zt-app\.go189\.cn\/zt-app\/welcome\/.*Animation reject-img
^https?:\/\/cloud\.189\.cn\/include\/splash\/ reject

# === 2. 21CN 及三方聚合开屏广告接口 ===
^https?:\/\/(ad|ad\.k|admarket|adshows)\.21cn\.com\/.* reject-dict
^https?:\/\/.*\.gdt\.qq\.com\/.* reject-dict
^https?:\/\/.*\.pangolin-sdk-toutiao[0-9a-z-]*\.com\/.* reject-dict
^https?:\/\/.*\.pglstatp-toutiao\.com\/.* reject-dict

[MitM]
hostname = zt-app.go189.cn, cloud.189.cn, ad.21cn.com, ad.k.21cn.com, admarket.21cn.com, adshows.21cn.com, *.gdt.qq.com, *.pangolin-sdk-toutiao.com, *.pangolin-sdk-toutiao1.com, *.pangolin-sdk-toutiao-b.com, *.pglstatp-toutiao.com
