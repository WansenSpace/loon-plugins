#!name = 腾讯动漫去广告V4
#!desc = 极限净化：拦截开屏/弹窗/气泡/签到领奖、我的页面福利中心/游戏中心/八宫格、书架推荐/红点、AI/限免卡/成长任务、搜索热词、V会员页完整内容及主流聚合广告 SDK
#!author = WansenSpace
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/63/5f/7f/635f7fbf-22c8-feb9-c8db-acda372d6ca3/AppIcon-0-1x_U007emarketing-0-8-0-0-sRGB-85-220-0.png/512x512bb.jpg
#!system = iOS
#!system_version = 15.0
#!loon_version = 3.2.0
#!date = 2026-11-27

[Rule]
# === 1. 屏蔽 QUIC 与腾讯 HTTPDNS，防止绕过域名规则和 MitM ===
PROTOCOL, QUIC, REJECT
IP-CIDR, 119.29.29.98/32, REJECT, no-resolve

# === 2. 腾讯动漫广告子域 ===
DOMAIN-SUFFIX, a.ac.qq.com, REJECT
DOMAIN-SUFFIX, ad.ac.qq.com, REJECT
DOMAIN-SUFFIX, ad.qq.com, REJECT

# === 3. 腾讯广点通 / 优量汇 & 遥测统计（抓包实测） ===
DOMAIN-SUFFIX, gdt.qq.com, REJECT
DOMAIN-SUFFIX, gdtimg.com, REJECT
DOMAIN-SUFFIX, ugdtimg.com, REJECT
DOMAIN, pgdt.gtimg.cn, REJECT
DOMAIN, tangram.e.qq.com, REJECT
DOMAIN, sdk.e.qq.com, REJECT
DOMAIN, sdkreport.e.qq.com, REJECT
DOMAIN, us.l.qq.com, REJECT
DOMAIN, l.qq.com, REJECT
DOMAIN, h.trace.qq.com, REJECT
DOMAIN, oth.eve.mdt.qq.com, REJECT
DOMAIN, oth.str.mdt.qq.com, REJECT
DOMAIN, galileotelemetry.tencent.com, REJECT
DOMAIN, snowflake.qq.com, REJECT
DOMAIN, beacon.cdn.qq.com, REJECT
DOMAIN, receiver.tdm.qq.com, REJECT
DOMAIN, hc.tdm.qq.com, REJECT
DOMAIN, guid.tpns.tencent.com, REJECT
DOMAIN, cloud.tgpa.qq.com, REJECT
DOMAIN-SUFFIX, beacon.qq.com, REJECT
DOMAIN-SUFFIX, tpstelemetry.tencent.com, REJECT

# === 4. 穿山甲 / 字节广告联盟（含抓包实测域名） ===
DOMAIN-KEYWORD, pangolin-sdk-toutiao, REJECT
DOMAIN-SUFFIX, pglstatp-toutiao.com, REJECT
DOMAIN-SUFFIX, pangolin.snssdk.com, REJECT
DOMAIN-SUFFIX, csjplatform.com, REJECT
DOMAIN, mssdk.volces.com, REJECT
DOMAIN, apmplus.volces.com, REJECT

# === 5. 快手广告联盟（仅拦截广告子域，不误伤快手主站） ===
DOMAIN-SUFFIX, e.kuaishou.com, REJECT
DOMAIN-SUFFIX, ad.v6.kuaishou.com, REJECT
DOMAIN-SUFFIX, promotion-partner.kuaishou.com, REJECT
DOMAIN-SUFFIX, wlog.kuaishou.com, REJECT
DOMAIN-SUFFIX, gdfp.gifshow.com, REJECT

# === 6. 百度移动广告联盟 / 百青藤（仅广告子域，不误伤百度搜索） ===
DOMAIN-SUFFIX, mobads.baidu.com, REJECT
DOMAIN-SUFFIX, mobads-logs.baidu.com, REJECT
DOMAIN-SUFFIX, mobads-pre-config.cdn.bcebos.com, REJECT
DOMAIN-SUFFIX, cpro.baidu.com, REJECT
DOMAIN-SUFFIX, pos.baidu.com, REJECT
DOMAIN-SUFFIX, union.baidu.com, REJECT
DOMAIN-SUFFIX, eiv.baidu.com, REJECT
DOMAIN-SUFFIX, als.baidu.com, REJECT
DOMAIN-SUFFIX, hm.baidu.com, REJECT

# === 7. Sigmob / TopOn 聚合及京东、阿里广告 SDK ===
DOMAIN-SUFFIX, sigmob.cn, REJECT
DOMAIN-SUFFIX, sigmob.com, REJECT
DOMAIN-SUFFIX, anythinktech.com, REJECT
DOMAIN-SUFFIX, toponad.com, REJECT
DOMAIN, janapi.jd.com, REJECT
DOMAIN, dsp-x.jd.com, REJECT
DOMAIN, xlog.jd.com, REJECT
DOMAIN, adashx.m.taobao.com, REJECT
DOMAIN, adashxgc.ut.taobao.com, REJECT

# === 8. 「我的」页游戏中心（起点小游戏平台，抓包实测） ===
DOMAIN, wgame.qidian.com, REJECT
DOMAIN, lygame.qidian.com, REJECT
DOMAIN, newsentry.qidian.com, REJECT

[Rewrite]
# === 阻断腾讯 HTTPDNS 明文请求 ===
^http:\/\/119\.29\.29\.98\/.* reject

# === 开屏、弹窗、气泡、签到领奖 ===
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/Support\/(getSystemConf|bootScreen) reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/User\/popup\/.* reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/Home\/bubble\/.* reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/SignIn\/getEventEntrance reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/Gift\/getGiftNotice\/.* reject-200

# === 极限净化：「我的」页卡片（福利中心/游戏中心/八宫格/宝箱/小游戏/V会员广告） ===
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/User\/getUserCard reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/User\/async reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/IntelligentAgent\/getUserCenterComment reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/LimitFreeCard\/getCardInfo reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/Task\/getGrowInfo reject-200

# === 「我的」页红框入口落地页：签到、福利中心、我的卡牌、小游戏 ===
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/Task\/getEventEntrance.* reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/Welfare\/.* reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/MiniGame\/.* reject-200
^https?:\/\/m\.ac\.qq\.com\/event\/(welfareChannel|cardGame)\/.* reject-200
^https?:\/\/gtimgcdn\.ac\.qq\.com\/h5_hd\/(welfareChannel|cardGame)\/.* reject

# === 书架「喜欢看」推荐（返回空响应，模拟服务器原生“无数据”，避免网络故障） ===
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/Recommend\/getBookShelfRecommend reject-200

# === 搜索热词 ===
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/Search\/hotWord reject-200

# === V4 实验：拦截全局配置 / AB 实验 / 离线页面配置，尝试隐藏底部「V会员」并阻止离线页面 ===
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/Support\/commonConf reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/ABTest\/getExperimentList reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/Support\/getHybridConf.* reject-200

# === 极限净化：V会员页（主接口 + H5 页 + 专属反馈通道） ===
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/VClub\/home($|\?|\/) reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/VClub\/homeAsync reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/VClub\/navigationBarTip reject-200
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/VClub\/iosPayConfigs\/.* reject-200
^https?:\/\/m\.ac\.qq\.com\/event\/appHtmlPage\/weex\/v-club-home\.html.* reject-200
^https?:\/\/gtimg(cdn)?\.ac\.qq\.com\/h5_hd\/appHtmlPage\/weex\/(v-club-home|css\/v-club-home).* reject
^https?:\/\/gtimg(cdn)?\.ac\.qq\.com\/h5_hd\/appHtmlPage\/weex\/images\/v-club\/.* reject-img
^https?:\/\/(iphone\.)?ac\.qq\.com\/.*\/Support\/getAiseeUrl.*v_club_feedback.* reject-200

# === 通用广告与推广接口 ===
^https?:\/\/.*\.ac\.qq\.com\/.*(splash|getSplash|bootScreen|adRealTime|promotion\/|getAd|advert) reject-200
^https?:\/\/img0\.qidian\.com\/upload\/gamesy\/.* reject-img
^https?:\/\/webcast-open\.douyin\.com\/webcast\/openapi\/pangle\/.* reject-dict
^https?:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad\/.* reject-dict
^https?:\/\/tnc\d+-[a-z0-9]+\.zijieapi\.com\/get_domains\/.* reject-dict
^https?:\/\/vod-license-m\.volccdn\.com\/vod-license\/.*webcast.* reject
^https?:\/\/.*\.gdt\.qq\.com\/.* reject-dict
^https?:\/\/.*\.pangolin-sdk-toutiao[0-9a-z-]*\.com\/.* reject-dict
^https?:\/\/.*\.pglstatp-toutiao\.com\/.* reject-dict

[MitM]
hostname = ac.qq.com, iphone.ac.qq.com, m.ac.qq.com, *.ac.qq.com, *.gdt.qq.com, *.pangolin-sdk-toutiao.com, *.pangolin-sdk-toutiao1.com, *.pangolin-sdk-toutiao-b.com, *.pglstatp-toutiao.com, webcast-open.douyin.com, img0.qidian.com, lf-cdn-tos.bytescm.com, tnc3-alisc1.zijieapi.com, vod-license-m.volccdn.com
